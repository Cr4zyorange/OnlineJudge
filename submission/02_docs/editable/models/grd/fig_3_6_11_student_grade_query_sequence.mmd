sequenceDiagram
  actor Student as 学生
  participant View as StudentGradeView
  participant Controller as GradeRecordController
  participant Service as GradeRecordService
  participant Course as CoursePermissionClient
  participant SummaryRepo as CourseGradeSummaryRepository
  participant RecordRepo as GradeRecordRepository
  Student->>View: 打开课程成绩页
  View->>Controller: GET /courses/{courseId}/my-grades
  Controller->>Service: getMyPublishedGrades(courseId,currentUser.id)
  Service->>Course: isCourseMember(courseId,studentId)
  alt 非课程成员
    Course-->>Service: false
    Service-->>Controller: StudentGradeAccessException（ERR-GRD-02 / 403）
    Controller-->>View: 无权限响应，不含成绩数据
  else 课程成员
    Course-->>Service: true
    Service->>SummaryRepo: findByCourseId(courseId)
    SummaryRepo-->>Service: 课程总评集合
    Service->>Service: 筛选 studentId 与 PUBLISHED
    alt 总评不存在或未发布
      Service-->>Controller: GradePublishException（ERR-GRD-04 / 400）
      Controller-->>View: 未发布响应，不含分数字段
    else 总评已发布
      Service->>RecordRepo: findByCourseId(courseId)
      RecordRepo-->>Service: 课程成绩记录集合
      Service->>Service: 筛选 studentId 与 PUBLISHED 并排序
      Service-->>Controller: CourseGradeRow
      Controller-->>View: 已发布总评、明细和发布时间
    end
  end
