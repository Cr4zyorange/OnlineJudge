@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
title 图 4-5 CRS 课程与教学资源用例图
actor "学生" as Student
actor "教师" as Teacher

rectangle "CRS 课程与教学资源" {
  usecase "UC-CRS-01\n教师创建课程并上传资源" as CreateCourse
  usecase "维护课程章节" as Chapter
  usecase "上传教学资源" as Resource
  usecase "发布课程公告" as Announcement
  usecase "UC-CRS-02\n学生加入课程" as JoinCourse
  usecase "审核加入申请" as ReviewJoin
  usecase "校验课程成员关系" as MemberCheck
  usecase "校验课程管理权限" as ManageCheck
}

Teacher --> CreateCourse
Teacher --> Chapter
Teacher --> Resource
Teacher --> Announcement
Student --> JoinCourse
Teacher --> ReviewJoin

CreateCourse ..> ManageCheck : <<include>>
Chapter ..> ManageCheck : <<include>>
Resource ..> ManageCheck : <<include>>
Announcement ..> ManageCheck : <<include>>
JoinCourse ..> MemberCheck : <<include>>
ReviewJoin ..> ManageCheck : <<include>>
ReviewJoin ..> JoinCourse : <<extend>>
@enduml
