@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
title 图 4-3 系统核心用例总览图
actor "未登录访问者" as Visitor
actor "学生" as Student
actor "教师" as Teacher
actor "管理员" as Admin

rectangle "在线教学与实训平台（OnlineJudgeForSE）" {
  usecase "AUTH 用户权限与平台安全" as AUTH
  usecase "CRS 课程与教学资源" as CRS
  usecase "LRN 学习过程与通知提醒" as LRN
  usecase "LAB 实训实验" as LAB
  usecase "HWK 作业与自动评测" as HWK
  usecase "GRD 成绩评价与教学分析" as GRD
}

Visitor --> AUTH
Student --> AUTH
Teacher --> AUTH
Admin --> AUTH
Student --> CRS
Teacher --> CRS
Student --> LRN
Teacher --> LRN
Teacher --> LAB
Student --> LAB
Teacher --> HWK
Student --> HWK
Teacher --> GRD
Student --> GRD
Admin --> GRD
@enduml
