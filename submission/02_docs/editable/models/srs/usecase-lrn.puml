@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
title 图 4-6 LRN 学习过程与通知提醒用例图
actor "学生" as Student
actor "教师" as Teacher

rectangle "LRN 学习过程与通知提醒" {
  usecase "UC-LRN-01\n查看学习任务、通知和进度" as Learning
  usecase "聚合个人学习任务" as Tasks
  usecase "保存学习进度" as Progress
  usecase "记录学习行为" as Behavior
  usecase "查看站内通知" as Notification
  usecase "处理通知状态" as NotificationState
  usecase "查看课程学习统计" as CourseStats
  usecase "校验课程成员关系" as MemberCheck
}

Student --> Learning
Student --> Notification
Teacher --> CourseStats

Learning ..> MemberCheck : <<include>>
Learning ..> Tasks : <<include>>
Learning ..> Progress : <<include>>
Behavior ..> Learning : <<extend>>
Notification ..> NotificationState : <<include>>
Notification ..> MemberCheck : <<include>>
CourseStats ..> MemberCheck : <<include>>
@enduml
