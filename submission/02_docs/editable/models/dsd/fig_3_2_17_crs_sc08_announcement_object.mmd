sequenceDiagram
  participant Teacher as 教师
  participant Ctrl as CourseController
  participant Svc as AnnouncementService
  participant Repo as AnnouncementRepository
  participant Event as NotificationEventPublisher
  participant DB as MySQL 数据库
  Teacher->>Ctrl: POST /api/v1/courses/{courseId}/announcements
  Ctrl->>Svc: create(courseId, AnnouncementRequest, user)
  Svc->>Svc: requireManagePermission(courseId, user)
  Svc->>Svc: sanitize(content)
  Svc->>Repo: insert(courseId, request, publisherId, sanitizedContent)
  Repo->>DB: INSERT crs_announcement
  DB-->>Repo: Announcement
  Repo-->>Svc: Announcement
  Svc->>Event: publish(CRS_ANNOUNCEMENT 通知事件)
  Svc-->>Ctrl: AnnouncementResponse
  Teacher->>Ctrl: PUT /api/v1/courses/{courseId}/announcements/{id}/top
  Ctrl->>Svc: updateTop(courseId, announcementId, top, user)
  Svc->>Repo: updateTop(courseId, announcementId, top)
  Repo->>DB: UPDATE crs_announcement
  DB-->>Repo: Announcement(isPinned)
  Svc-->>Ctrl: AnnouncementResponse
  Ctrl-->>Teacher: 置顶状态已更新
