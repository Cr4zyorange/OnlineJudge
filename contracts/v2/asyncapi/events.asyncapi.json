{
  "asyncapi": "3.0.0",
  "info": {
    "title": "OnlineJudge five-service domain events",
    "version": "2.0.0",
    "description": "All messages are at-least-once domain facts. Consumers deduplicate eventId and reject or reconcile stale aggregateVersion values; this contract never promises exactly-once delivery. Each message binds one closed payload schema, aggregate type, aggregate-id template, and ordering key."
  },
  "defaultContentType": "application/json",
  "servers": {
    "broker": { "host": "${RABBITMQ_HOST}", "protocol": "amqp", "protocolVersion": "0.9.1", "description": "The future broker implementation belongs to #337; this file fixes its message contract now." }
  },
  "channels": {
    "identitySecurityVersionChanged": { "address": "onlinejudge.identity.security-version.changed.v2", "messages": { "identitySecurityVersionChanged": { "$ref": "#/components/messages/identity.security-version.changed.v2" } } },
    "courseMemberChanged": { "address": "onlinejudge.course.member.changed.v2", "messages": { "courseMemberChanged": { "$ref": "#/components/messages/course.member.changed.v2" } } },
    "courseAnnouncementPublished": { "address": "onlinejudge.course.announcement.published.v2", "messages": { "courseAnnouncementPublished": { "$ref": "#/components/messages/course.announcement.published.v2" } } },
    "assessmentSourceGradeChanged": { "address": "onlinejudge.assessment.source-grade.changed.v2", "messages": { "assessmentSourceGradeChanged": { "$ref": "#/components/messages/assessment.source-grade.changed.v2" } } },
    "assessmentEvaluationCompleted": { "address": "onlinejudge.assessment.evaluation.completed.v2", "messages": { "assessmentEvaluationCompleted": { "$ref": "#/components/messages/assessment.evaluation.completed.v2" } } },
    "assessmentHomeworkPublished": { "address": "onlinejudge.assessment.homework.published.v2", "messages": { "assessmentHomeworkPublished": { "$ref": "#/components/messages/assessment.homework.published.v2" } } },
    "gradePublished": { "address": "onlinejudge.grade.published.v2", "messages": { "gradePublished": { "$ref": "#/components/messages/grade.published.v2" } } },
    "gradeReviewProcessed": { "address": "onlinejudge.grade.review.processed.v2", "messages": { "gradeReviewProcessed": { "$ref": "#/components/messages/grade.review.processed.v2" } } }
  },
  "operations": {
    "identityPublishesSecurityVersion": { "action": "send", "channel": { "$ref": "#/channels/identitySecurityVersionChanged" }, "messages": [{ "$ref": "#/channels/identitySecurityVersionChanged/messages/identitySecurityVersionChanged" }] },
    "coursePublishesMembership": { "action": "send", "channel": { "$ref": "#/channels/courseMemberChanged" }, "messages": [{ "$ref": "#/channels/courseMemberChanged/messages/courseMemberChanged" }] },
    "coursePublishesAnnouncement": { "action": "send", "channel": { "$ref": "#/channels/courseAnnouncementPublished" }, "messages": [{ "$ref": "#/channels/courseAnnouncementPublished/messages/courseAnnouncementPublished" }] },
    "assessmentPublishesSourceGrade": { "action": "send", "channel": { "$ref": "#/channels/assessmentSourceGradeChanged" }, "messages": [{ "$ref": "#/channels/assessmentSourceGradeChanged/messages/assessmentSourceGradeChanged" }] },
    "assessmentPublishesEvaluation": { "action": "send", "channel": { "$ref": "#/channels/assessmentEvaluationCompleted" }, "messages": [{ "$ref": "#/channels/assessmentEvaluationCompleted/messages/assessmentEvaluationCompleted" }] },
    "assessmentPublishesHomework": { "action": "send", "channel": { "$ref": "#/channels/assessmentHomeworkPublished" }, "messages": [{ "$ref": "#/channels/assessmentHomeworkPublished/messages/assessmentHomeworkPublished" }] },
    "gradePublishesPublication": { "action": "send", "channel": { "$ref": "#/channels/gradePublished" }, "messages": [{ "$ref": "#/channels/gradePublished/messages/gradePublished" }] },
    "gradePublishesReview": { "action": "send", "channel": { "$ref": "#/channels/gradeReviewProcessed" }, "messages": [{ "$ref": "#/channels/gradeReviewProcessed/messages/gradeReviewProcessed" }] }
  },
  "components": {
    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "eventType", "payloadVersion", "aggregateType", "aggregateId", "aggregateVersion", "occurredAt", "correlationId", "payload"],
        "properties": {
          "eventId": { "type": "string", "format": "uuid", "description": "Transport deduplication key; immutable across redelivery and replay." },
          "eventType": { "type": "string", "enum": ["identity.security-version.changed.v2", "course.member.changed.v2", "course.announcement.published.v2", "assessment.source-grade.changed.v2", "assessment.evaluation.completed.v2", "assessment.homework.published.v2", "grade.published.v2", "grade.review.processed.v2"] },
          "payloadVersion": { "const": 2, "description": "A breaking payload change creates a new event type or a new payloadVersion; consumers do not guess field meanings." },
          "aggregateType": { "type": "string", "minLength": 1 },
          "aggregateId": { "type": "string", "minLength": 1, "description": "Must equal the event schema's x-onlinejudge-aggregate-id-template after substituting payload fields." },
          "aggregateVersion": { "type": "integer", "minimum": 1, "description": "Strictly increasing per aggregate at the producer. Consumers retain their last processed version and reconcile a gap." },
          "occurredAt": { "type": "string", "format": "date-time" },
          "correlationId": { "type": "string", "format": "uuid", "description": "Originating X-Request-Id propagated across sync and async hops." },
          "payload": { "type": "object", "description": "Event-specific public fact; never an internal table row or repository object." }
        }
      },
      "IdentitySecurityVersionChangedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "identity.security-version.changed.v2" }, "aggregateType": { "const": "identity-user" }, "payload": { "$ref": "#/components/schemas/IdentitySecurityVersionChangedPayload" } }, "x-onlinejudge-aggregate-id-template": "{userId}" }] },
      "CourseMemberChangedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "course.member.changed.v2" }, "aggregateType": { "const": "course-member" }, "payload": { "$ref": "#/components/schemas/CourseMemberChangedPayload" } }, "x-onlinejudge-aggregate-id-template": "{courseId}:{userId}" }] },
      "CourseAnnouncementPublishedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "course.announcement.published.v2" }, "aggregateType": { "const": "course-announcement" }, "payload": { "$ref": "#/components/schemas/CourseAnnouncementPublishedPayload" } }, "x-onlinejudge-aggregate-id-template": "{announcementId}" }] },
      "AssessmentSourceGradeChangedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "assessment.source-grade.changed.v2" }, "aggregateType": { "const": "assessment-source-grade" }, "payload": { "$ref": "#/components/schemas/AssessmentSourceGradeChangedPayload" } }, "x-onlinejudge-aggregate-id-template": "{sourceType}:{sourceId}:{studentId}" }] },
      "AssessmentEvaluationCompletedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "assessment.evaluation.completed.v2" }, "aggregateType": { "const": "assessment-submission" }, "payload": { "$ref": "#/components/schemas/AssessmentEvaluationCompletedPayload" } }, "x-onlinejudge-aggregate-id-template": "{submissionId}" }] },
      "AssessmentHomeworkPublishedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "assessment.homework.published.v2" }, "aggregateType": { "const": "assessment-homework" }, "payload": { "$ref": "#/components/schemas/AssessmentHomeworkPublishedPayload" } }, "x-onlinejudge-aggregate-id-template": "{homeworkId}" }] },
      "GradePublishedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "grade.published.v2" }, "aggregateType": { "const": "grade-publication" }, "payload": { "$ref": "#/components/schemas/GradePublishedPayload" } }, "x-onlinejudge-aggregate-id-template": "{publicationId}" }] },
      "GradeReviewProcessedEvent": { "allOf": [{ "$ref": "#/components/schemas/EventEnvelope" }, { "type": "object", "properties": { "eventType": { "const": "grade.review.processed.v2" }, "aggregateType": { "const": "grade-review" }, "payload": { "$ref": "#/components/schemas/GradeReviewProcessedPayload" } }, "x-onlinejudge-aggregate-id-template": "{reviewRequestId}" }] },
      "IdentitySecurityVersionChangedPayload": { "type": "object", "additionalProperties": false, "required": ["userId", "securityVersion", "changeReason"], "properties": { "userId": { "type": "string", "minLength": 1 }, "securityVersion": { "type": "integer", "minimum": 1 }, "changeReason": { "type": "string", "enum": ["LOGOUT", "PASSWORD_CHANGED", "ROLE_CHANGED", "PERMISSION_CHANGED", "ACCOUNT_STATUS_CHANGED"] } } },
      "CourseMemberChangedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "userId", "membershipStatus", "memberVersion"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "userId": { "type": "string", "minLength": 1 }, "membershipStatus": { "type": "string", "enum": ["ACTIVE", "REMOVED"] }, "memberVersion": { "type": "integer", "minimum": 1 } } },
      "CourseAnnouncementPublishedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "announcementId", "publishedAt"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "announcementId": { "type": "string", "minLength": 1 }, "publishedAt": { "type": "string", "format": "date-time" } } },
      "AssessmentSourceGradeChangedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "sourceType", "sourceId", "studentId", "score", "fullScore", "sourceVersion"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "sourceType": { "type": "string", "enum": ["LAB", "HWK"] }, "sourceId": { "type": "string", "minLength": 1 }, "studentId": { "type": "string", "minLength": 1 }, "score": { "type": "number", "minimum": 0 }, "fullScore": { "type": "number", "minimum": 0 }, "sourceVersion": { "type": "integer", "minimum": 1 } } },
      "AssessmentEvaluationCompletedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "submissionId", "evaluationStatus", "evaluationVersion", "completedAt"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "submissionId": { "type": "string", "minLength": 1 }, "evaluationStatus": { "type": "string", "enum": ["SUCCESS", "FAILED", "CANCELLED"] }, "evaluationVersion": { "type": "integer", "minimum": 1 }, "completedAt": { "type": "string", "format": "date-time" } } },
      "AssessmentHomeworkPublishedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "homeworkId", "publishedAt"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "homeworkId": { "type": "string", "minLength": 1 }, "publishedAt": { "type": "string", "format": "date-time" } } },
      "GradePublishedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "publicationId", "publishedAt", "publicationVersion"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "publicationId": { "type": "string", "minLength": 1 }, "publishedAt": { "type": "string", "format": "date-time" }, "publicationVersion": { "type": "integer", "minimum": 1 } } },
      "GradeReviewProcessedPayload": { "type": "object", "additionalProperties": false, "required": ["courseId", "reviewRequestId", "studentId", "reviewStatus", "resultVersion", "processedAt"], "properties": { "courseId": { "type": "string", "minLength": 1 }, "reviewRequestId": { "type": "string", "minLength": 1 }, "studentId": { "type": "string", "minLength": 1 }, "reviewStatus": { "type": "string", "enum": ["APPROVED", "REJECTED"] }, "resultVersion": { "type": "integer", "minimum": 1 }, "processedAt": { "type": "string", "format": "date-time" } } }
    },
    "messages": {
      "identity.security-version.changed.v2": { "name": "identity.security-version.changed.v2", "title": "User security version changed", "payload": { "$ref": "#/components/schemas/IdentitySecurityVersionChangedEvent" }, "x-onlinejudge-producer": "identity", "x-onlinejudge-consumers": ["course", "assessment", "grade", "learning"], "x-onlinejudge-idempotency-key": "eventId; consumers store eventId before applying the new minimum securityVersion", "x-onlinejudge-ordering": "identity-user aggregateVersion" },
      "course.member.changed.v2": { "name": "course.member.changed.v2", "title": "Course membership changed", "payload": { "$ref": "#/components/schemas/CourseMemberChangedEvent" }, "x-onlinejudge-producer": "course", "x-onlinejudge-consumers": ["assessment", "learning"], "x-onlinejudge-idempotency-key": "eventId; projection key courseId:userId:memberVersion", "x-onlinejudge-ordering": "course-member aggregateVersion" },
      "course.announcement.published.v2": { "name": "course.announcement.published.v2", "title": "Course announcement published", "payload": { "$ref": "#/components/schemas/CourseAnnouncementPublishedEvent" }, "x-onlinejudge-producer": "course", "x-onlinejudge-consumers": ["learning"], "x-onlinejudge-idempotency-key": "eventId; notification key announcementId:recipientUserId", "x-onlinejudge-ordering": "course-announcement aggregateVersion" },
      "assessment.source-grade.changed.v2": { "name": "assessment.source-grade.changed.v2", "title": "Published assessment source grade changed", "payload": { "$ref": "#/components/schemas/AssessmentSourceGradeChangedEvent" }, "x-onlinejudge-producer": "assessment", "x-onlinejudge-consumers": ["grade"], "x-onlinejudge-idempotency-key": "eventId; source projection key sourceType:sourceId:studentId:sourceVersion", "x-onlinejudge-ordering": "assessment-source-grade aggregateVersion" },
      "assessment.evaluation.completed.v2": { "name": "assessment.evaluation.completed.v2", "title": "Assessment evaluation reached a terminal state", "payload": { "$ref": "#/components/schemas/AssessmentEvaluationCompletedEvent" }, "x-onlinejudge-producer": "assessment", "x-onlinejudge-consumers": ["learning"], "x-onlinejudge-idempotency-key": "eventId; notification key submissionId:evaluationVersion", "x-onlinejudge-ordering": "assessment-submission aggregateVersion" },
      "assessment.homework.published.v2": { "name": "assessment.homework.published.v2", "title": "Homework published", "payload": { "$ref": "#/components/schemas/AssessmentHomeworkPublishedEvent" }, "x-onlinejudge-producer": "assessment", "x-onlinejudge-consumers": ["learning"], "x-onlinejudge-idempotency-key": "eventId; notification key homeworkId:recipientUserId", "x-onlinejudge-ordering": "assessment-homework aggregateVersion" },
      "grade.published.v2": { "name": "grade.published.v2", "title": "Grade publication completed", "payload": { "$ref": "#/components/schemas/GradePublishedEvent" }, "x-onlinejudge-producer": "grade", "x-onlinejudge-consumers": ["learning"], "x-onlinejudge-idempotency-key": "eventId; notification key publicationId:recipientUserId", "x-onlinejudge-ordering": "grade-publication aggregateVersion" },
      "grade.review.processed.v2": { "name": "grade.review.processed.v2", "title": "Grade review processed", "payload": { "$ref": "#/components/schemas/GradeReviewProcessedEvent" }, "x-onlinejudge-producer": "grade", "x-onlinejudge-consumers": ["learning"], "x-onlinejudge-idempotency-key": "eventId; notification key reviewRequestId:resultVersion", "x-onlinejudge-ordering": "grade-review aggregateVersion" }
    }
  }
}
