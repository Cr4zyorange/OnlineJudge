{
  "openapi": "3.1.0",
  "info": {
    "title": "OnlineJudge Identity Service internal contract",
    "version": "2.0.0",
    "description": "Audience-bound identity documents for the five-service architecture. This is a service contract, not a public login API replacement."
  },
  "x-onlinejudge-service": "identity",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "getJwks",
        "summary": "Get current and overlapping verification keys",
        "x-onlinejudge-timeout-ms": 500,
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": { "description": "JWKS; responses carry Cache-Control and must overlap key rotation longer than the maximum accepted token lifetime", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Jwks" } } } },
          "503": { "description": "Identity is temporarily unavailable; existing, unexpired tokens remain locally verifiable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/internal/v2/service-tokens": {
      "post": {
        "operationId": "mintServiceToken",
        "summary": "Mint a short-lived token bound to one target service audience",
        "description": "The caller authenticates with a workload identity over mTLS. A token is never a shared global internal secret.",
        "x-onlinejudge-timeout-ms": 1000,
        "security": [{ "mTLS": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128 } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceTokenRequest" } } } },
        "responses": {
          "201": { "description": "A token with audience equal to the requested target service", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceTokenResponse" } } } },
          "400": { "description": "Malformed request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Missing, invalid, or expired workload mTLS service identity", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_INVALID"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Authenticated workload service identity lacks scope for the requested audience", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_FORBIDDEN"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Idempotency key was reused with a different request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Identity cannot mint a new token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userJwt": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "serviceJwt": { "type": "apiKey", "in": "header", "name": "X-OnlineJudge-Service-Authorization", "description": "Bearer service JWT whose aud equals this service" },
      "mTLS": { "type": "mutualTLS" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message", "requestId", "retryable"],
        "properties": {
          "code": { "type": "string", "examples": ["SERVICE_IDENTITY_FORBIDDEN"] },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "retryable": { "type": "boolean" },
          "details": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Page": {
        "type": "object",
        "required": ["items", "page", "size", "total"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "page": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "Jwks": { "type": "object", "required": ["keys"], "properties": { "keys": { "type": "array", "items": { "type": "object", "required": ["kty", "kid", "use"], "properties": { "kty": { "type": "string" }, "kid": { "type": "string" }, "use": { "const": "sig" } } } } } },
      "UserAccessTokenClaims": {
        "type": "object",
        "required": ["userId", "roles", "permissions", "sessionId", "securityVersion", "iat", "exp", "iss", "aud"],
        "properties": {
          "userId": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "sessionId": { "type": "string" },
          "securityVersion": { "type": "integer", "minimum": 0 },
          "iat": { "type": "integer" },
          "exp": { "type": "integer" },
          "iss": { "type": "string", "const": "onlinejudge.identity.v2" },
          "aud": { "type": "string", "const": "onlinejudge.api" }
        }
      },
      "ServiceTokenRequest": { "type": "object", "required": ["audience", "scopes"], "properties": { "audience": { "enum": ["course", "assessment", "grade", "learning"] }, "scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
      "ServiceTokenResponse": { "type": "object", "required": ["accessToken", "expiresAt", "audience"], "properties": { "accessToken": { "type": "string", "writeOnly": true }, "expiresAt": { "type": "string", "format": "date-time" }, "audience": { "type": "string" } } }
    }
  }
}
