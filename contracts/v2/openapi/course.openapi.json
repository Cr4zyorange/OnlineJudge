{
  "openapi": "3.1.0",
  "info": { "title": "OnlineJudge Course Service internal contract", "version": "2.0.0" },
  "x-onlinejudge-service": "course",
  "paths": {
    "/internal/v2/courses/{courseId}/authorizations/{userId}": {
      "get": {
        "operationId": "getCourseAuthorization", "x-onlinejudge-timeout-ms": 800,
        "description": "A live permission decision. Callers must not fall back to a Course table, repository, cache, or local SPI when this endpoint is unavailable.",
        "security": [{ "serviceJwt": [] }, { "mTLS": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "courseId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "action", "in": "query", "required": true, "schema": { "enum": ["VIEW", "MANAGE", "MANAGE_GRADE", "LIST_MEMBERS"] } }
        ],
        "responses": {
          "200": { "description": "Permission decision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizationDecision" } } } },
          "401": { "description": "Missing, invalid, expired, or wrong-audience service JWT; or invalid workload mTLS service identity", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_INVALID"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Authenticated service principal lacks the required course authorization scope", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_FORBIDDEN"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Course does not exist", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Decision cannot be made; caller rejects the user operation without a local data fallback", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/internal/v2/courses/{courseId}/members": {
      "get": {
        "operationId": "listCourseMembers", "x-onlinejudge-timeout-ms": 1000,
        "security": [{ "serviceJwt": [] }, { "mTLS": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "courseId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "role", "in": "query", "required": false, "schema": { "enum": ["STUDENT", "TEACHER", "ASSISTANT"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": { "200": { "description": "Member page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "401": { "description": "Missing, invalid, expired, or wrong-audience service JWT; or invalid workload mTLS service identity", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_INVALID"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "403": { "description": "Authenticated service principal lacks the required course member-read scope", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_FORBIDDEN"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "503": { "description": "Unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
      }
    },
    "/internal/v2/learning/tasks/recent": {
      "get": {
        "operationId": "getRecentCourseLearningTasks", "x-onlinejudge-timeout-ms": 800,
        "description": "Course's LRN role returns bounded recent task summaries for one active course member. An outage is not an empty task list.",
        "security": [{ "serviceJwt": [] }, { "mTLS": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "courseId", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "userId", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 5, "default": 5 } }
        ],
        "responses": {
          "200": { "description": "Recent task page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecentTaskPage" } } } },
          "401": { "description": "Missing, invalid, expired, or wrong-audience service JWT", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_INVALID"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Authenticated service principal lacks the learning.tasks.read scope", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_FORBIDDEN"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Course cannot answer; caller rejects the user operation without a local task fallback", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/internal/v2/notifications/reconciliation-requests": {
      "post": {
        "operationId": "requestCourseNotificationReconciliation", "x-onlinejudge-timeout-ms": 1000,
        "description": "A Course-owned durable reconciliation request for an LRN DLQ or projection gap. Source business facts are never rolled back because this endpoint is unavailable.",
        "security": [{ "serviceJwt": [] }, { "mTLS": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128 } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReconciliationRequest" } } } },
        "responses": {
          "202": { "description": "A durable reconciliation request was accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReconciliationAccepted" } } } },
          "401": { "description": "Missing, invalid, expired, or wrong-audience service JWT", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_INVALID"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Authenticated service principal lacks notification-reconciliation scope", "x-onlinejudge-error-codes": ["SERVICE_IDENTITY_FORBIDDEN"], "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Idempotency key conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Course cannot accept reconciliation now; caller records an operational alert", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "userJwt": { "type": "http", "scheme": "bearer" }, "serviceJwt": { "type": "apiKey", "in": "header", "name": "X-OnlineJudge-Service-Authorization" }, "mTLS": { "type": "mutualTLS" } },
    "schemas": {
      "Error": { "type": "object", "required": ["code", "message", "requestId", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" }, "retryable": { "type": "boolean" } } },
      "Page": { "type": "object", "required": ["items", "page", "size", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } }, "page": { "type": "integer" }, "size": { "type": "integer" }, "total": { "type": "integer" } } },
      "Member": { "type": "object", "required": ["userId", "role", "memberVersion"], "properties": { "userId": { "type": "string" }, "role": { "type": "string" }, "memberVersion": { "type": "integer", "minimum": 1 } } },
      "AuthorizationDecision": { "type": "object", "required": ["allowed", "courseId", "userId", "action", "memberVersion"], "properties": { "allowed": { "type": "boolean" }, "courseId": { "type": "string" }, "userId": { "type": "string" }, "action": { "type": "string" }, "memberVersion": { "type": "integer", "minimum": 1 } } },
      "ReconciliationRequest": { "type": "object", "required": ["sourceService", "eventId", "reason"], "properties": { "sourceService": { "enum": ["course", "assessment", "grade"] }, "eventId": { "type": "string", "format": "uuid" }, "reason": { "enum": ["DLQ", "PROJECTION_GAP", "OPERATOR_REPLAY"] } } },
      "ReconciliationAccepted": { "type": "object", "required": ["requestId", "status"], "properties": { "requestId": { "type": "string", "format": "uuid" }, "status": { "const": "ACCEPTED" } } },
      "RecentTask": { "type": "object", "required": ["taskId", "taskType", "title", "courseId", "courseName", "progress", "status"], "properties": { "taskId": { "type": "integer" }, "taskType": { "enum": ["RESOURCE", "EXPERIMENT", "HOMEWORK"] }, "title": { "type": "string" }, "courseId": { "type": "integer", "minimum": 1 }, "courseName": { "type": "string" }, "deadline": { "type": ["string", "null"] }, "progress": { "type": "integer", "minimum": 0, "maximum": 100 }, "status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "OVERDUE"] }, "actionUrl": { "type": ["string", "null"] } } },
      "RecentTaskPage": { "type": "object", "required": ["items", "page", "size", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/RecentTask" } }, "page": { "type": "integer" }, "size": { "type": "integer" }, "total": { "type": "integer" } } }
    }
  }
}
