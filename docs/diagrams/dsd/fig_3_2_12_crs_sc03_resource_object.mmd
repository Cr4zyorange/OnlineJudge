sequenceDiagram
  participant Teacher as 教师
  participant Ctrl as ResourceController
  participant Svc as ResourceService
  participant File as FileStorageService
  participant Repo as ResourceRepository
  participant DB as MySQL 数据库
  Teacher->>Ctrl: POST /api/v1/courses/{courseId}/resources
  Ctrl->>Svc: upload(courseId, file, name, chapterId, type, visibility, publishAt, user)
  Svc->>Svc: requireManagePermission(courseId, user)
  Svc->>Svc: validateFile(file)
  Svc->>File: store(originalFilename, contentType, inputStream)
  File-->>Svc: StoredFile
  Svc->>Repo: insert(courseId, chapterId, ..., storageKey)
  Repo->>DB: INSERT crs_resource
  DB-->>Repo: 返回资源主键
  Repo-->>Svc: CourseResource
  Svc-->>Ctrl: ResourceResponse
  Ctrl-->>Teacher: 返回资源元数据与下载入口
  Teacher->>Ctrl: GET /api/v1/courses/{courseId}/resources/{resourceId}/download
  Ctrl->>Svc: download(courseId, resourceId, user)
  Svc->>File: load(storageKey)
  File-->>Svc: StoredFile
  Svc-->>Ctrl: ResourceDownload
