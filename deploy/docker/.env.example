GIT_SHA=
OJ_HTTP_PORT=8088
MYSQL_DATABASE=onlinejudge
MYSQL_USER=onlinejudge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Bootstrap snapshot consumed before the backend makes any network request.
# Supply the exact JSON returned by Identity's /.well-known/jwks.json endpoint.
IDENTITY_JWKS_TRUST_BUNDLE=
# Identity's reachable JWKS endpoint. Refresh failures retain the bootstrap
# snapshot so existing sessions continue to verify offline.
IDENTITY_JWKS_URI=
ONLINEJUDGE_DEMO_DATA_ENABLED=true
ONLINEJUDGE_EVALUATION_SANDBOX_MODE=fake
ASSESSMENT_IDENTITY_JWKS_TRUST_BUNDLE=
ASSESSMENT_IDENTITY_JWKS_URI=
ASSESSMENT_SANDBOX_COMMAND=
AUTH_HTTP_PORT=8081
AUTH_DB_USER=onlinejudge_auth
AUTH_DB_PASSWORD=
AUTH_DB_ROOT_PASSWORD=
AUTH_SEED_DATA_ENABLED=false
COURSE_DATABASE_PASSWORD=
RABBITMQ_USER=oj_course_events
RABBITMQ_PASSWORD=
# Course -> Learning workload identity.  The supported Compose default is the
# renewable mTLS credential provisioned by the tls-init one-shot (see
# compose.yml); COURSE_LEARNING_SERVICE_TOKEN is only a short-lived service-JWT
# override and must stay empty for the renewable mTLS path.
COURSE_LEARNING_SERVICE_TOKEN=
# Comma-separated certificate subjects allowed to call Course's internal v2
# endpoints over mTLS.  Single-RDN subjects only (the allowlist splits on ',').
COURSE_INTERNAL_MTLS_SERVICE_SUBJECTS=CN=assessment-api,CN=learning-api,CN=grade-api
