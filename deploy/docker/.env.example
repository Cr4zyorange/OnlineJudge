GIT_SHA=
OJ_HTTP_PORT=8088
MYSQL_DATABASE=onlinejudge
MYSQL_USER=onlinejudge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Bootstrap snapshot consumed before the backend makes any network request.
# Supply the exact JSON returned by Identity's /.well-known/jwks.json endpoint.
IDENTITY_JWKS_TRUST_BUNDLE=
# Identity's reachable JWKS endpoint. Refresh failures retain the bootstrap
# snapshot so existing sessions continue to verify offline.
IDENTITY_JWKS_URI=
ONLINEJUDGE_DEMO_DATA_ENABLED=true
ONLINEJUDGE_EVALUATION_SANDBOX_MODE=fake
AUTH_HTTP_PORT=8081
AUTH_DB_USER=onlinejudge_auth
AUTH_DB_PASSWORD=
AUTH_DB_ROOT_PASSWORD=
AUTH_SEED_DATA_ENABLED=false
