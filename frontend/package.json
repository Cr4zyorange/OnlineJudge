{
  "name": "onlinejudge-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:grd:disposable": "bash ../scripts/test/run-grd-e2e-disposable.sh",
    "test:e2e:contract": "node --test tests/contracts/shared-e2e-entry.contract.test.mjs",
    "test:e2e:verify-failure": "node scripts/verify-e2e-failure.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.3.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^25.9.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "mermaid": "^11.17.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "vue-tsc": "^2.2.10"
  }
}
